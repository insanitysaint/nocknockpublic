# Set these in Vercel: Project -> Settings -> Environment Variables (Production). Never commit real values.

# Where the backend (the n8n engine on your Oracle VM) lives. The installer prints these 5 settings for you.

N8N_BASE_URL=https://YOUR-SERVER-HOSTNAME
N8N_PROXY_USER=vercel
N8N_PROXY_PASSWORD=

# Signs the login cookie. Any random string of 32+ characters:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Your web-app login, printed by the installer as one JSON line (or make one: node scripts/hash-password.mjs me "Your Name" you@example.com).
AUTH_USERS=[]

# The address of this app once deployed, e.g. https://my-outreach.vercel.app (no trailing slash)
APP_URL=

# Optional, only if you want "Sign in with Google": GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, ALLOWED_EMAILS
# Optional, for the Team / AI keys / Lead sources pages: DATABASE_URL (Postgres) and INTEGRATIONS_KEY (32+ random characters)
